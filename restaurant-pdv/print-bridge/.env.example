# URL pública do app Next.js (Railway/Render em produção, http://localhost:3000 em dev)
API_BASE_URL="http://localhost:3000"

# Mesmo valor de BRIDGE_API_KEY configurado no .env do app principal
BRIDGE_API_KEY="replace-me"

# Intervalo de checagem por novos pedidos, em milissegundos
POLL_INTERVAL_MS="4000"

# console | usb | network
PRINTER_MODE="console"

# Usado apenas quando PRINTER_MODE=usb
PRINTER_USB_PATH="/dev/usb/lp0"

# Usados apenas quando PRINTER_MODE=network
PRINTER_HOST="192.168.1.50"
PRINTER_PORT="9100"
