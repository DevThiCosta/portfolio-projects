DATABASE_URL="postgresql://user:password@localhost:5432/bar_pos_dev?schema=public"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Shared secret the print-bridge service uses to authenticate against
# /api/print-jobs/* — not a staff session, a machine credential.
BRIDGE_API_KEY="replace-me"

# Mercado Pago (Pix + card terminal) — leave empty in dev, Pix screen
# will show a clear "gateway not configured" message instead of erroring.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Public URL of this app, used as the Mercado Pago webhook callback
# (must be a real HTTPS URL in production — Pix confirmation won't reach
# you on localhost).
APP_URL="http://localhost:3000"
