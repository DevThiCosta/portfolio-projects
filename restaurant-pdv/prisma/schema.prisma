// Bar POS — schema de dados

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAIXA
  GARCOM
}

enum ComandaStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ComandaSource {
  STAFF
  QR
}

enum ComandaItemStatus {
  PENDING
  SENT_TO_KITCHEN
  PREPARING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_TERMINAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
}

enum ExpenseKind {
  FIXA
  VARIAVEL
  COMPRA_INSUMO
  COMPRA_SERVICO
}

enum ExpenseStatus {
  ATIVA
  CANCELADA
}

enum PaymentTerm {
  AVISTA
  PRAZO_UNICO
  PRAZO_PARCELADO
}

enum SupplierKind {
  INSUMO
  SERVICO
  AMBOS
}

model User {
  id           String   @id @default(cuid())
  name         String
  role         Role
  pinHash      String? // garcom/caixa: login rapido por PIN
  username     String?  @unique // admin: login usuario+senha
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  comandasOpened      Comanda[]        @relation("ComandaOpenedBy")
  comandaItemsCreated ComandaItem[]    @relation("ComandaItemCreatedBy")
  paymentsReceived    Payment[]        @relation("PaymentReceivedBy")
  stockMovements      StockMovement[]  @relation("StockMovementCreatedBy")
  insumoMovements     InsumoMovement[] @relation("InsumoMovementCreatedBy")
  expensesCreated     Expense[]        @relation("ExpenseCreatedBy")

  @@index([role])
}

model Mesa {
  id       String    @id @default(cuid())
  label    String    @unique
  active   Boolean   @default(true)
  qrToken  String?   @unique // Fase 2: pedido do cliente via QR code
  comandas Comanda[]
}

model Product {
  id                String   @id @default(cuid())
  name              String
  category          String
  price             Decimal  @db.Decimal(10, 2)
  stock             Int? // null = nao rastreado; ignorado se o produto tiver receita (ingredients)
  lowStockThreshold Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  comandaItems   ComandaItem[]
  stockMovements StockMovement[]
  // Se tiver 1+ linhas aqui, o produto e "composto": disponibilidade e
  // decontada dos insumos da receita, e o campo `stock` acima e ignorado.
  ingredients    ProductIngredient[]

  @@index([active, category])
}

/// Insumo/ingrediente cru (cachaca, limao, batata, etc.) usado nas receitas
/// de produtos compostos (caipirinha, porcoes de comida...).
model Insumo {
  id                String   @id @default(cuid())
  name              String
  unit              String // rotulo livre: "ml", "g", "un" — sem conversao, so exibicao
  stock             Decimal  @db.Decimal(10, 3)
  lowStockThreshold Decimal? @db.Decimal(10, 3)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  usedIn        ProductIngredient[]
  movements     InsumoMovement[]
  purchaseItems ExpenseItem[]

  @@index([active])
}

/// Uma linha de receita: "para vender 1 unidade de `product`, consome
/// `quantityPerUnit` de `insumo`".
model ProductIngredient {
  id              String  @id @default(cuid())
  product         Product @relation(fields: [productId], references: [id])
  productId       String
  insumo          Insumo  @relation(fields: [insumoId], references: [id])
  insumoId        String
  quantityPerUnit Decimal @db.Decimal(10, 3)

  @@unique([productId, insumoId])
  @@index([productId])
}

model InsumoMovement {
  id                String   @id @default(cuid())
  insumo            Insumo   @relation(fields: [insumoId], references: [id])
  insumoId          String
  delta             Decimal  @db.Decimal(10, 3) // negativo = saida, positivo = entrada
  reason            String // ex: "venda", "reposicao", "perda"
  relatedComandaId  String?
  relatedExpenseId  String? // preenchido quando a movimentacao vem de uma compra/estorno em Expense
  createdBy         User?    @relation("InsumoMovementCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId   String?
  createdAt         DateTime @default(now())

  @@index([insumoId])
}

model Comanda {
  id           String        @id @default(cuid())
  mesa         Mesa          @relation(fields: [mesaId], references: [id])
  mesaId       String
  status       ComandaStatus @default(OPEN)
  source       ComandaSource @default(STAFF)
  openedBy     User          @relation("ComandaOpenedBy", fields: [openedByUserId], references: [id])
  openedByUserId String
  openedAt     DateTime      @default(now())
  closedAt     DateTime?

  items    ComandaItem[]
  payments Payment[]
  printJobs PrintJob[]

  // No maximo uma comanda OPEN por mesa por vez, garantido em app-level
  // (checagem + transacao) - ver app/lib/comandas.ts
  @@index([mesaId, status])
}

model ComandaItem {
  id              String            @id @default(cuid())
  comanda         Comanda           @relation(fields: [comandaId], references: [id])
  comandaId       String
  product         Product           @relation(fields: [productId], references: [id])
  productId       String
  quantity        Int
  unitPriceAtOrder Decimal          @db.Decimal(10, 2)
  notes           String?
  status          ComandaItemStatus @default(PENDING)
  createdBy       User?             @relation("ComandaItemCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?
  createdAt       DateTime          @default(now())

  @@index([comandaId, status])
}

model Payment {
  id               String        @id @default(cuid())
  comanda          Comanda       @relation(fields: [comandaId], references: [id])
  comandaId        String
  method           PaymentMethod
  amount           Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  gatewayPaymentId String? // id da cobranca no gateway (Mercado Pago)
  gatewayQrCode    String?       @db.Text // payload do QR Pix, exibido em tela
  receivedBy       User?         @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id])
  receivedByUserId String?
  createdAt        DateTime      @default(now())
  confirmedAt      DateTime?

  @@index([comandaId])
  @@index([gatewayPaymentId])
}

model PrintJob {
  id           String         @id @default(cuid())
  comanda      Comanda        @relation(fields: [comandaId], references: [id])
  comandaId    String
  payload      Json // snapshot: mesa, itens, hora
  status       PrintJobStatus @default(PENDING)
  attempts     Int            @default(0)
  errorMessage String?
  createdAt    DateTime       @default(now())
  printedAt    DateTime?

  @@index([status])
}

model StockMovement {
  id                String   @id @default(cuid())
  product           Product  @relation(fields: [productId], references: [id])
  productId         String
  delta             Int // negativo = saida, positivo = entrada
  reason            String // ex: "venda", "reposicao", "perda"
  relatedComandaId  String?
  createdBy         User?    @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId   String?
  createdAt         DateTime @default(now())

  @@index([productId])
}

model Supplier {
  id          String       @id @default(cuid())
  name        String
  kind        SupplierKind @default(AMBOS)
  document    String? // CNPJ/CPF, opcional
  contactName String?
  phone       String?
  email       String?
  notes       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  expenses Expense[]

  @@index([active])
}

/// Lancamento financeiro: cobre tanto contas fixas/variaveis (aluguel,
/// internet...) quanto compras de fornecedor (insumo ou servico). `kind`
/// discrimina a origem; compras tem `items`, contas normalmente nao.
model Expense {
  id                      String        @id @default(cuid())
  kind                    ExpenseKind
  status                  ExpenseStatus @default(ATIVA)
  description             String
  category                String // rotulo livre: "Aluguel", "Energia", "Insumos"...
  supplier                Supplier?     @relation(fields: [supplierId], references: [id])
  supplierId              String?
  amount                  Decimal       @db.Decimal(10, 2) // total; em compras = soma dos items
  paymentTerm             PaymentTerm
  installmentsCount       Int           @default(1)
  installmentIntervalDays Int           @default(30) // usado so quando PRAZO_PARCELADO
  issuedAt                DateTime      @default(now()) // data da conta/nota
  competencia             DateTime? // mes de referencia (dia 1, horario BR) - so FIXA/VARIAVEL
  notes                   String?
  createdBy               User?         @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId         String?
  createdAt               DateTime      @default(now())

  items        ExpenseItem[]
  installments ExpenseInstallment[]

  @@index([kind, status])
  @@index([competencia])
  @@index([supplierId])
}

/// Linha de uma compra (nota fiscal). insumoId setado = reposicao
/// automatica de estoque; null = item de servico/despesa avulsa, so contabil.
model ExpenseItem {
  id          String   @id @default(cuid())
  expense     Expense  @relation(fields: [expenseId], references: [id])
  expenseId   String
  insumo      Insumo?  @relation(fields: [insumoId], references: [id])
  insumoId    String?
  description String // texto livre da nota, ex "Cachaca 51 1L"
  quantity    Decimal  @db.Decimal(10, 3)
  unitCost    Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(10, 2) // quantity * unitCost, persistido p/ auditoria
  createdAt   DateTime @default(now())

  @@index([expenseId])
  @@index([insumoId])
}

model ExpenseInstallment {
  id        String    @id @default(cuid())
  expense   Expense   @relation(fields: [expenseId], references: [id])
  expenseId String
  number    Int // 1-based
  dueDate   DateTime
  amount    Decimal   @db.Decimal(10, 2)
  paid      Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([expenseId, number])
  @@index([expenseId])
  @@index([dueDate, paid])
}
